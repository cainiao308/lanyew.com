<script language="javascript">
    var now = new Date();

    function createtime() {
        var grt = new Date('2013/5/24 00:00:00'); /* 网站启用时间 */
        now.setTime(now.getTime() + 250);
        var totalSeconds = (now - grt) / 1000;
        var totalDays = Math.floor(totalSeconds / 86400);
        
        // 计算年数和剩余天数（按每年365天计算）
        var years = Math.floor(totalDays / 365);
        var days = totalDays % 365;
        
        // 计算小时
        var hours = (totalSeconds / 3600) - (totalDays * 24);
        var hnum = Math.floor(hours);
        if (String(hnum).length == 1) {
            hnum = "0" + hnum;
        }
        
        // 计算分钟
        var minutes = (totalSeconds / 60) - (totalDays * 24 * 60) - (hnum * 60);
        var mnum = Math.floor(minutes);
        if (String(mnum).length == 1) {
            mnum = "0" + mnum;
        }
        
        // 计算秒
        var seconds = totalSeconds - (totalDays * 24 * 60 * 60) - (hnum * 60 * 60) - (mnum * 60);
        var snum = Math.round(seconds);
        if (String(snum).length == 1) {
            snum = "0" + snum;
        }
        
        // 更新显示内容
        document.getElementById("timeDate").innerHTML = "已稳定运行" + years + "年" + days + "天";
        document.getElementById("times").innerHTML = hnum + "小时" + mnum + "分" + snum + "秒";
    }

    setInterval("createtime()", 250);

    /**
     * 点击刷新验证码（保持不变）
     */
    $("#captcha").click(function() {
        captchaRefresh($(this))
    })

    function captchaRefresh($t) {
        var timestamp = new Date().getTime()
        var blogUrl = $("#blog_url").val();
        $t.attr("src", blogUrl + "/include/lib/checkcode.php?" + timestamp)
    }
</script>
