<script>
    layui.use(['table'], function () {
        var table = layui.table;
        var $ = layui.$;
        $('.name_id').click(function () {
            $('.name_id').removeClass('name_click');
            var name_id = $(this).attr('name_id');
            $(this).addClass('name_click');
            if (name_id > 0) {
                $('.index_menu').hide();
                $('.name_' + name_id).show();
                $('.index_title').hide();
            } else {
                $('.index_title').show();
                $('.index_menu').show();
                $('.index_title').css('display', 'inline-block');
            }
            $.ajax({
                type: 'get',
                url: '/index/index/nameid',
                data: 'name_id=' + name_id,
                dataType: 'json',
                success: function () {

                }
            });
        });
        $('#search_name').bind('keydown', function (event) {
            if (event.keyCode == "13") {
                Search();
            }
        });
        $('.jquery_count span').click(function () {
            var id = parseInt($(this).attr('data-id'));
            if (id) {
                var that = $(this);
                that.attr('data-id', 0);
                layer.load(0, {shade: false});
                $.ajax({
                    type: 'post',
                    url: '/index/index/collect',
                    data: 'id=' + id,
                    dataType: 'json',
                    success: function (json) {
                        layer.closeAll();
                        layer.msg(json.msg);
                        that.attr('data-id', id);
                        if (json.status == 0) {
                            if (json.msg == '收藏成功') {
                                that.css('color', '#f06f6f');
                                that.html('<i class="fa fa-fw fa-heart"></i> 取消收藏');
                            } else {
                                that.css('color', '#666666');
                                that.html('<i class="fa fa-fw fa-heart"></i> 加入收藏');
                            }

                        }
                    }
                });
            }
        });
        $('.search_name').click(function () {
            var name = $(this).html();
            $('#search_name').val(name);
            Search();
        });
        $('.search').on('click', function () {
            Search();
        });
        function SearchMenu(key) {
            $.ajax({
                type: 'post',
                url: '/index/index/search',
                data: 'key=' + key,
                dataType: 'json',
                success: function (json) {
                    if (json.status == 0) {
                        if (json.msg.length > 0) {
                            var html = '<div class="menu_list"><span class="layui-badge layui-bg-green">在线工具</span>';
                            $(json.msg).each(function (i, j) {
                                html += '<div class="search_result"><a href=' + (j.url) + '  target="_blank"><img src="/public/index/' + j.id + '.png" width="15"/> <span>' + j.name + '</span> - ' + j.brief + '</a></div>';
                            });
                            html += "</div>";
                            $('.lmcjl_search').append(html);
                        }
                    }
                }});
        }
        function SearchJquery(key) {
            $.ajax({type: 'post', url: '/index/index/jquery', data: 'key=' + key, dataType: 'json', success: function (json) {
                    if (json.status == 0) {
                        if (json.msg.length > 0) {
                            var html = '<div class="jquery_list"><span class="layui-badge layui-badge">网站模板插件</span>';
                            $(json.msg).each(function (i, j) {
                                html += '<div class="search_result"><a href="/index/javascript/jqueryview/id/' + j.id + '.html"  target="_blank"><i class="fa fa-fw fa-leaf"></i> <span>' + j.name + '</span> - ' + j.introduce + '</a></div>';
                            });
                            html += "</div>";
                            $('.lmcjl_search').append(html);
                        }
                    }
                }});
        }
        function SearchProgram(key) {
            $.ajax({type: 'post', url: '/index/index/searchfault', data: 'key=' + key, dataType: 'json', success: function (json) {
                    if (json.status == 0) {
                        if (json.msg.length > 0) {
                            var html = '<div class="search_fault"><span class="layui-badge layui-bg-green">技术故障方案</span>';
                            $(json.msg).each(function (i, j) {
                                html += '<div class="search_result"><a href="/index/program/faultview/id/' + j.doc_id + '.html"  target="_blank"><i class="fa fa-code"></i> <span>' + j.doc_name + '</span></a></div>';
                            });
                            html += "</div>";
                            $('.lmcjl_search').append(html);
                        }
                    }
                }});
        }
        function SearchResume(key) {
            $.ajax({type: 'post', url: '/index/index/resume', data: 'key=' + key, dataType: 'json', success: function (json) {
                    if (json.status == 0) {
                        if (json.msg.length > 0) {
                            var html = '<div class="resume_list"><span class="layui-badge layui-bg-blue">简历模板</span>';
                            $(json.msg).each(function (i, j) {
                                html += '<div class="search_result"><a href="/index/resume/resumeview/id/' + j.id + '.html"  target="_blank"><i class="fa fa-cloud-download"></i> <span>' + j.name + '</span></a></div>';
                            });
                            html += "</div>";
                            $('.lmcjl_search').append(html);
                        }
                    }
                }});
        }
        function Search() {
            var search_name = $('#search_name').val();
            if (isEmpty(search_name)) {
                layer.msg('请输入功能名称');
                return false;
            }
            if (search_name.length > 88) {
                layer.msg('大佬，饶了小的吧，搜索关键词不用这么长吧！');
                return false;
            }
            $('.lmcjl_content').click();
            $('.lmcjl_search').html('');
            $('.menu_list').html('');
            layer.load(0, {shade: false});
            $.ajax({type: 'post', url: '/index/index/searchkey', data: 'key=' + search_name, dataType: 'json', success: function (json) {
                    if (json.status == 0) {
                        SearchMenu(json.msg);
                        SearchProgram(json.msg);
                        SearchJquery(json.msg);
                        SearchResume(json.msg);
                        layer.closeAll();
                    } else {
                        layer.closeAll();
                        layer.msg(json.msg);
                    }
                }});
        }
    });
</script>
